# Copy to .env for local dev. NEVER commit real secrets.
ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=info

# PORT (PaaS convention). Railway / Heroku / Fly inject $PORT at runtime; when
# set it OVERRIDES HTTP_ADDR and the server binds 0.0.0.0:$PORT so the platform
# edge can route to it. Leave unset locally to keep HTTP_ADDR (:8080).
# PORT=8080

# Run all pending up migrations in-process at boot (embedded; no shell/migrate
# binary needed). Off for local dev; set true on Railway so the distroless image
# self-migrates before serving. A migration error is fatal (except no-change).
MIGRATE_ON_BOOT=false

# Optional TLS. Set BOTH to serve HTTPS directly; leave empty to serve plain
# HTTP (e.g. when TLS is terminated at a load balancer / service mesh).
TLS_CERT_FILE=
TLS_KEY_FILE=

# PostgreSQL
DATABASE_URL=postgres://pg:pg@localhost:5432/payment_gateway?sslmode=disable

# Auth. In production these secrets MUST be non-empty, at least 32 bytes, and
# NOT the 'change-me-in-prod' placeholder — the process fails fast otherwise.
JWT_SECRET=change-me-in-prod
IDEMPOTENCY_TTL_SECONDS=86400

# Admin API key gating the /v1/admin operator console. Presented via the
# X-Admin-Key header and compared with a constant-time compare. Empty disables
# the admin surface entirely (every /v1/admin request returns 401).
ADMIN_API_KEY=

# Directory served as static files so the dashboard / admin / checkout UIs run
# same-origin with the API (no CORS). Empty disables static serving.
WEB_DIR=./web

# CORS allowlist (comma-separated explicit checkout origins). NEVER use '*' on
# this authenticated money API. Empty disables CORS entirely (safe default).
# Still needed when the API is called cross-origin; same-origin (WEB_DIR) avoids it.
CORS_ALLOW_ORIGINS=

# Per-merchant rate limit ceiling (requests/sec) on the payments/QR groups.
# Health / metrics / webhook are never rate limited.
RATE_LIMIT_PER_SEC=600

# Public self-service signup (POST /v1/merchants) is IP-rate-limited on its own.
# Max onboarding calls per client IP per rolling hour (429 when exceeded).
SIGNUP_RATE_LIMIT_PER_HOUR=5

# pgx pool sizing (per-env tunable). MaxConns must stay under PG max_connections.
DB_MAX_CONNS=50
DB_MIN_CONNS=10

# Metrics exposure. /metrics leaks business/volume telemetry, so it is NOT on the
# public listener by default. Set METRICS_ADDR to bind it on a separate internal
# port (e.g. ':9090'); set METRICS_PUBLIC=true only in dev to mount it publicly.
METRICS_ADDR=
METRICS_PUBLIC=false

# Tokenization vault (HSM/KMS-backed in prod)
KMS_KEY_ID=alias/payment-gateway-cardvault
VAULT_NAMESPACE=cardvault

# Upstream acquirer / card switch (sandbox)
ACQUIRER_BASE_URL=https://sandbox.acquirer.example.com
ACQUIRER_API_KEY=sandbox-key

# QR payment webhook shared secret (HMAC-SHA256 over the raw request body)
QR_WEBHOOK_SECRET=change-me-in-prod

# Outbound webhook delivery (worker signs bodies with HMAC-SHA256 -> X-Signature)
WEBHOOK_SIGNING_SECRET=change-me-in-prod
# Fallback endpoint when an event row has no per-merchant target_url
WEBHOOK_DEFAULT_URL=
WEBHOOK_MAX_ATTEMPTS=6

# Settlement fee on captured volume, in basis points (250 = 2.50%)
SETTLEMENT_FEE_BPS=0

# QR provider (sandbox) origin used to build simulated QR image URLs
QR_PROVIDER_BASE_URL=https://sandbox.qr.example.com

# Sandbox payer simulator. When true, mounts the PUBLIC /v1/sandbox/... endpoints
# that let a browser (the "Sandbox Bank" mobile-banking simulator at /sandbox/)
# mark a QR payment paid/failed WITHOUT a merchant API key — the SERVER signs the
# confirmation internally, so the webhook secret is never exposed. MUST stay false
# on any real deploy: when false every sandbox route is absent (404). Dev only.
SANDBOX_MODE=false

# Default PromptPay proxy the QR funds settle to (set exactly one).
# In production this is resolved per-merchant from the merchant profile.
PROMPTPAY_MOBILE_NO=0812345678
# PROMPTPAY_NATIONAL_ID=1234567890123
# PROMPTPAY_EWALLET_ID=123456789012345

# --- Merchant dashboard login (Phase 1) ---
# Google OIDC. Leave blank to disable the Google button (dev-login still works in sandbox).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the Next.js app; Google redirect_uri = <base>/api/auth/google/callback
OAUTH_REDIRECT_BASE=http://localhost:3000
# pc_session cookie lifetime in hours (default 168 = 7 days)
SESSION_TTL_HOURS=168
